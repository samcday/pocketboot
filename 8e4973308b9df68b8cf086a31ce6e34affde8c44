What this establishes: both independently pinned targets build complete
Android boot images using the CI toolchain; generated configs retain required
built-ins; zImage and the correct processed board DTB are actually packaged;
Expressatt's GPU-off and USB-peripheral overlay survives packaging; embedded
/init and BusyBox are executable static ARM ELF32 binaries. It does NOT
establish partition fit or hardware boot/functionality.

The following standalone Python validation was run from the project root:

```python
from pathlib import Path
import gzip, hashlib, struct, subprocess, tomllib

root = Path.cwd()
for soc, name in [('msm8930', 'expressltexx'), ('msm8960', 'expressatt')]:
    stem = f'{soc}-samsung-{name}'
    cfg = tomllib.loads((root / f'configs/device/qcom/{stem}.toml').read_text())
    b = cfg['bootimg']
    out = root / f'target/kernel/qcom/{stem}'
    data = (out / 'boot.img').read_bytes()
    assert data[:8] == b'ANDROID!'
    ks, ka, rs, ra, ss, sa, tags, page, version, osv = struct.unpack_from('<10I', data, 8)
    assert (ka, ra, sa, tags) == tuple(b['base'] + b[k] for k in ['kernel_offset', 'ramdisk_offset', 'second_offset', 'tags_offset'])
    assert (page, version, ss, rs) == (2048, 0, 0, b.get('ramdisk_size', 0))
    image = (out / 'arch/arm/boot/zImage').read_bytes()
    dtbpath = out / ('pocketboot.dtb' if name == 'expressatt' else f'arch/arm/boot/dts/qcom/qcom-{stem}.dtb')
    dtb = dtbpath.read_bytes()
    assert struct.unpack_from('<I', image, 0x24)[0] == 0x016f2818
    assert struct.unpack_from('>2I', dtb) == (0xd00dfeed, len(dtb))
    assert data[page:page + ks] == image + dtb
    aligned = lambda n: (n + page - 1) // page * page
    assert len(data) == page + aligned(ks) + aligned(rs)
    rd = data[page + aligned(ks):page + aligned(ks) + rs]
    digest = hashlib.sha1(image + dtb + struct.pack('<I', ks) + rd + struct.pack('<I', rs) + struct.pack('<I', 0)).digest()
    assert data[576:596] == digest
    def prop(node, key):
        return subprocess.check_output(['fdtget', '-t', 's', str(dtbpath), node, key], text=True).strip()
    assert prop('/', 'compatible') == f'samsung,{name} qcom,{soc}'
    if name == 'expressatt':
        assert prop('/soc/gpu@4300000', 'status') == 'disabled'
        assert prop('/soc/iommu@7c00000', 'status') == 'disabled'
        assert prop('/soc/usb@12500000', 'dr_mode') == 'peripheral'
        assert prop('/soc/dsi@4700000/panel@0', 'compatible') == 'magnachip,ams452gp32'
        expected = ['DRM_MSM', 'DRM_MSM_MDP4', 'DRM_MSM_DSI_28NM_8960_PHY', 'MSM_IOMMU', 'DRM_PANEL_MAGNACHIP_AMS452GP32', 'INTERCONNECT', 'INTERCONNECT_QCOM', 'INTERCONNECT_QCOM_MSM8960']
    else:
        assert prop('/chosen/framebuffer@88a00000', 'compatible') == 'simple-framebuffer'
        expected = ['DRM_SIMPLEDRM', 'REGULATOR_QCOM_PM8917']
    kconfig = set((out / '.config').read_text().splitlines())
    for key in expected + ['KEXEC', 'MMC_ARMMMCI', 'MMC_QCOM_DML', 'USB_CHIPIDEA_UDC', 'USB_CONFIGFS_F_FS', 'TOUCHSCREEN_ATMEL_MXT', 'KEYBOARD_TM2_TOUCHKEY', 'PINCTRL_QCOM_SSBI_PMIC', 'INPUT_PMIC8XXX_PWRKEY']:
        assert f'CONFIG_{key}=y' in kconfig, key
    assert '# CONFIG_SMP is not set' in kconfig
    archive = (root / f'target/cpio/qcom/{stem}/pocketboot-initrd.cpio').read_bytes()
    members, pos = {}, 0
    while archive[pos:pos+6] == b'070701':
        fields = [int(archive[pos + 6 + i*8:pos + 14 + i*8], 16) for i in range(13)]
        mode, size, nlen = fields[1], fields[6], fields[11]
        member = archive[pos+110:pos+110+nlen-1].decode().removeprefix('./').removeprefix('/')
        pos = (pos + 110 + nlen + 3) & ~3
        members[member] = (mode, archive[pos:pos+size])
        pos = (pos + size + 3) & ~3
        if member == 'TRAILER!!!': break
    for member in ['init', 'bin/busybox']:
        mode, elf = members[member]
        assert mode & 0o111 and elf[:5] == b'\x7fELF\x01'
        assert struct.unpack_from('<H', elf, 18)[0] == 40
        phoff = struct.unpack_from('<I', elf, 28)[0]
        entsize, num = struct.unpack_from('<HH', elf, 42)
        assert all(struct.unpack_from('<I', elf, phoff + n*entsize)[0] != 3 for n in range(num)), 'dynamic interpreter'
    inc = (out / 'usr/initramfs_inc_data').read_bytes()
    print(f'{stem}: {len(data)} bytes ({len(data)/1048576:.2f} MiB), SHA256 {hashlib.sha256(data).hexdigest()}')
    print(f'  PASS v0/page/zImage/DTB/header SHA1/addresses, resolved drivers, SMP=n, static ARM init + BusyBox; initramfs_inc_data {len(inc)} bytes')
```
