Subject: [PATCH] arm64: dts: qcom: otter: isolate the PocketBoot diagnostic path

Chris's first distro boot lost USB around ADSP/PMIC GLINK startup. Use a
fixed USB2 peripheral without that firmware-dependent role/orientation
path for the initial PocketBoot trial. Drop the SS PHY reference, not
just maximum-speed, so its absent driver cannot defer the controller.
Select the UTMI clock in place of the absent SuperSpeed PIPE clock.

Retain the two panel rails while simpledrm uses the bootloader framebuffer.
This is not native display or Type-C/charging support.

Apply this only to PocketBoot's board-scoped source. It is a source patch
rather than a runtime DT overlay because deleting usb-role-switch and
replacing the PHY phandle list must work without base-DTB symbols.

diff --git a/arch/arm64/boot/dts/qcom/qcm6490-shift-otter.dts b/arch/arm64/boot/dts/qcom/qcm6490-shift-otter.dts
--- a/arch/arm64/boot/dts/qcom/qcm6490-shift-otter.dts
+++ b/arch/arm64/boot/dts/qcom/qcm6490-shift-otter.dts
@@ -73,6 +73,7 @@ key-custom {
 
 	pmic-glink {
 		compatible = "qcom,qcm6490-pmic-glink", "qcom,pmic-glink";
+		status = "disabled";
 
 		#address-cells = <1>;
 		#size-cells = <0>;
@@ -462,6 +463,7 @@ vreg_l11c: ldo11 {
 
 		vreg_l12c: ldo12 {
 			regulator-name = "vreg_l12c";
+			regulator-always-on;
 			regulator-min-microvolt = <1650000>;
 			regulator-max-microvolt = <2000000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
@@ -469,6 +471,7 @@ vreg_l12c: ldo12 {
 
 		vreg_l13c: ldo13 {
 			regulator-name = "vreg_l13c";
+			regulator-always-on;
 			regulator-min-microvolt = <2700000>;
 			regulator-max-microvolt = <3544000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
@@ -1077,8 +1080,12 @@ &ufs_mem_phy {
 };
 
 &usb_1 {
-	dr_mode = "otg";
-	usb-role-switch;
+	dr_mode = "peripheral";
+	/delete-property/ usb-role-switch;
+	maximum-speed = "high-speed";
+	qcom,select-utmi-as-pipe-clk;
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
 
 	status = "okay";
 };
@@ -1110,7 +1117,7 @@ &usb_1_qmpphy {
 	vdda-phy-supply = <&vreg_l6b>;
 	vdda-pll-supply = <&vreg_l1b>;
 
-	status = "okay";
+	status = "disabled";
 };
 
 &usb_dp_qmpphy_out {
