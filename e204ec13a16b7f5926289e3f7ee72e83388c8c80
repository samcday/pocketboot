import hashlib, json, os, pathlib, struct, subprocess, zlib
root = pathlib.Path('target/kernel/qcom/msm8939-xiaomi-ferrari')
scratch = pathlib.Path(os.environ['DELTA_SCRATCH_DIR'])
image = (root / 'boot.img').read_bytes()
assert image[:8] == b'ANDROID!'
kernel_size, load = struct.unpack_from('<II', image, 8)
page, version = struct.unpack_from('<II', image, 36)
assert (load, page, version) == (0x80080000, 2048, 0)
blob = image[page:page+kernel_size]
z = zlib.decompressobj(31)
envelope = z.decompress(blob) + z.flush()
assert z.eof and envelope[56:60] == b'ARM\x64'
text_offset, shim_runtime = struct.unpack_from('<QQ', envelope, 8)
assert (load & ~0x1fffff) + text_offset == load
payload_offset = ((load + shim_runtime + 0x1fffff) & ~0x1fffff) - load
assert payload_offset == 0x180000
assert (load + payload_offset) % 0x200000 == 0
inner = (root / 'arch/arm64/boot/Image').read_bytes()
assert envelope[payload_offset:payload_offset+len(inner)] == inner
assert inner[56:60] == b'ARM\x64'
inner_runtime, = struct.unpack_from('<Q', inner, 16)
assert len(envelope) >= payload_offset + max(len(inner), inner_runtime)
shim = pathlib.Path('target/preboot/qcom/msm8939-xiaomi-ferrari/pocketpreboot.bin').read_bytes()
assert payload_offset >= max(len(shim), shim_runtime)
assert envelope[:8] == shim[:8] and envelope[16:len(shim)] == shim[16:]
dtb = z.unused_data
header = struct.unpack_from('>10I', dtb)
magic, total, off_struct, off_strings, off_reserve, *_ = header
assert magic == 0xd00dfeed and total == len(dtb)
nodes = {}; stack = []; pos = off_struct
while True:
    token, = struct.unpack_from('>I', dtb, pos); pos += 4
    if token == 1:
        end = dtb.index(b'\0', pos)
        stack.append(dtb[pos:end].decode()); pos = (end+4) & ~3
        path = '/' + '/'.join(stack[1:]); nodes[path] = {}
    elif token == 2:
        stack.pop()
    elif token == 3:
        length, name_off = struct.unpack_from('>II', dtb, pos); pos += 8
        name_end = dtb.index(b'\0', off_strings+name_off)
        name = dtb[off_strings+name_off:name_end].decode()
        nodes['/'+'/'.join(stack[1:])][name] = dtb[pos:pos+length]
        pos = (pos+length+3) & ~3
    elif token == 4:
        pass
    elif token == 9:
        break
    else:
        raise AssertionError(token)
cpus = {p:props for p,props in nodes.items() if props.get('device_type') == b'cpu\0'}
expected = {0,1,2,3,0x100,0x101,0x102,0x103}
assert len(cpus) == 8 and {int.from_bytes(p['reg'],'big') for p in cpus.values()} == expected
assert all(p['enable-method'] == b'pocketboot,msm8939-acc\0' for p in cpus.values())
owned = [(p,props) for p,props in nodes.items() if b'pocketboot,spin-table-v1' in props.get('compatible',b'').split(b'\0')]
assert len(owned) == 1
owned_path, props = owned[0]
assert props['reg'] == struct.pack('>4I',0,0x854ff000,0,0x1000) and 'no-map' in props
assert int.from_bytes(nodes['/reserved-memory']['#address-cells'],'big') == 2
assert int.from_bytes(nodes['/reserved-memory']['#size-cells'],'big') == 2
reserved = []
for p, props in nodes.items():
    if p.startswith('/reserved-memory/') and p.count('/') == 2 and 'reg' in props:
        assert len(props['reg']) % 16 == 0
        for addr,size in struct.iter_unpack('>QQ', props['reg']):
            if p != owned_path and size:
                assert addr+size <= 0x854ff000 or addr >= 0x85500000, (p,addr,size)
            reserved.append({'node':p,'address':hex(addr),'size':hex(size)})
memreserve = []
while True:
    addr,size = struct.unpack_from('>QQ',dtb,off_reserve);off_reserve += 16
    if not (addr or size): break
    assert addr+size <= 0x854ff000 or addr >= 0x85500000
    memreserve.append([hex(addr),hex(size)])
config = (root / '.config').read_text()
for line in ['CONFIG_ARM64_SPIN_TABLE_KEXEC=y','CONFIG_NR_CPUS=8','CONFIG_HOTPLUG_CPU=y','CONFIG_KEXEC=y','CONFIG_ARM64_4K_PAGES=y','CONFIG_PSTORE_RAM=y','CONFIG_PSTORE_CONSOLE=y']:
    assert line+'\n' in config, line
(scratch/'ferrari-experiment.dtb').write_bytes(dtb)
subprocess.run(['dtc','-q','-I','dtb','-O','dts','-o',str(scratch/'ferrari-experiment.dts'),str(scratch/'ferrari-experiment.dtb')],check=True)
report = {'boot_img_sha256':hashlib.sha256(image).hexdigest(),'boot_img_bytes':len(image),'android_kernel_bytes':kernel_size,'load_address':hex(load),'outer_text_offset':hex(text_offset),'shim_file_bytes':len(shim),'shim_runtime_bytes':shim_runtime,'payload_offset':hex(payload_offset),'inner_load_address':hex(load+payload_offset),'inner_image_bytes':len(inner),'inner_runtime_bytes':inner_runtime,'envelope_bytes':len(envelope),'appended_dtb_bytes':len(dtb),'cpu_ids':list(map(hex,sorted(expected))),'cpu_method':'pocketboot,msm8939-acc','owned_region':[hex(0x854ff000),hex(0x85500000)],'reservations':reserved,'memreserve':memreserve,'limitation':'Static packaged DT only; live firmware-populated map and hardware behavior not verified'}
(scratch/'ferrari-package-inspection.json').write_text(json.dumps(report,indent=2)+'\n')
